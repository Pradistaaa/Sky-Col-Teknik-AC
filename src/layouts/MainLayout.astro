---
import { whatsapp } from "../lib/data.js";

const {
  title = "Sky Col Teknik AC | Service AC DKI Jakarta",
  description = "Sky Col Teknik AC - Jasa service, cuci, isi freon, bongkar pasang dan perbaikan AC di DKI Jakarta.",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#075985" />

    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="navbar">
      <div class="container nav-inner">

        <a href="/" class="brand">
          <span class="brand-icon">✦</span>

          <span>
            <strong>SKY COL</strong>
            <small>TEKNIK AC</small>
          </span>
        </a>

        <nav class="desktop-nav">
          <a href="/">Beranda</a>
          <a href="/layanan">Layanan</a>
          <a href="/harga">Harga</a>
          <a href="/tentang">Tentang</a>
          <a href="/cara-booking">Cara Booking</a>
          <a href="/faq">FAQ</a>
        </nav>

        <a
          href={whatsapp()}
          class="nav-cta"
          target="_blank"
          rel="noopener noreferrer"
        >
          Hubungi Kami
        </a>

        <details class="mobile-menu">
          <summary>☰</summary>

          <div class="mobile-panel">
            <a href="/">Beranda</a>
            <a href="/layanan">Layanan</a>
            <a href="/harga">Harga</a>
            <a href="/tentang">Tentang Kami</a>
            <a href="/cara-booking">Cara Booking</a>
            <a href="/faq">FAQ</a>

            <a
              href={whatsapp()}
              target="_blank"
              rel="noopener noreferrer"
              class="mobile-wa"
            >
              Hubungi WhatsApp
            </a>
          </div>
        </details>

      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="container footer-grid">

        <div class="footer-brand">
          <a href="/" class="brand">
            <span class="brand-icon">✦</span>

            <span>
              <strong>SKY COL</strong>
              <small>TEKNIK AC</small>
            </span>
          </a>

          <p>
            Solusi service dan perawatan AC untuk kebutuhan Anda
            di DKI Jakarta.
          </p>
        </div>

        <div class="footer-column">
          <h4>NAVIGASI</h4>
          <a href="/">Beranda</a>
          <a href="/layanan">Layanan</a>
          <a href="/harga">Daftar Harga</a>
          <a href="/tentang">Tentang Kami</a>
          <a href="/cara-booking">Cara Booking</a>
          <a href="/faq">FAQ</a>
        </div>

        <div class="footer-column">
          <h4>HUBUNGI</h4>

          <a
            href={whatsapp()}
            target="_blank"
            rel="noopener noreferrer"
          >
            0812 9798 3801
          </a>

          <span>DKI Jakarta</span>
        </div>

      </div>

      <div class="container copyright">
        <span>© 2026 Sky Col Teknik AC</span>
        <span>Service AC • DKI Jakarta</span>
      </div>
    </footer>

    <a
      class="floating-wa"
      href={whatsapp()}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Hubungi Sky Col Teknik AC via WhatsApp"
    >
      WA
    </a>
  </body>
</html>

<style is:global>
  :root {
    --blue: #075985;
    --blue-dark: #043b59;
    --blue-light: #eaf7fc;
    --cyan: #12a6d8;
    --ink: #10212d;
    --muted: #647783;
    --off: #f5f9fb;
    --line: #dce8ed;
    --shadow: 0 20px 60px rgba(7, 89, 133, 0.12);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: "DM Sans", sans-serif;
    color: var(--ink);
    background: #ffffff;
    line-height: 1.6;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .container {
    width: min(1160px, calc(100% - 40px));
    margin: 0 auto;
  }

  /* NAVBAR */

  .navbar {
    min-height: 82px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(220, 232, 237, 0.8);
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(15px);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .brand-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    background: var(--blue);
    color: white;
    border-radius: 10px;
    font-size: 19px;
  }

  .brand strong {
    display: block;
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    line-height: 1;
    letter-spacing: 1.4px;
  }

  .brand small {
    display: block;
    margin-top: 4px;
    color: var(--blue);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .desktop-nav a {
    color: #566975;
    font-size: 11px;
    font-weight: 600;
    transition: 0.2s;
  }

  .desktop-nav a:hover {
    color: var(--blue);
  }

  .nav-cta {
    background: var(--blue);
    color: white;
    padding: 12px 18px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
  }

  .nav-cta:hover {
    background: var(--blue-dark);
  }

  .mobile-menu {
    display: none;
    position: relative;
  }

  .mobile-menu summary {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 10px;
    cursor: pointer;
    font-size: 20px;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-panel {
    position: absolute;
    top: 52px;
    right: 0;
    width: 220px;
    padding: 12px;
    background: white;
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: var(--shadow);
  }

  .mobile-panel a {
    display: block;
    padding: 11px 12px;
    font-size: 12px;
    font-weight: 600;
    border-radius: 8px;
  }

  .mobile-panel a:hover {
    background: var(--blue-light);
    color: var(--blue);
  }

  .mobile-panel .mobile-wa {
    margin-top: 8px;
    background: var(--blue);
    color: white;
    text-align: center;
  }

  /* GENERAL */

  .section {
    padding: 100px 0;
  }

  .page-hero {
    padding: 90px 0;
    background:
      radial-gradient(
        circle at 80% 20%,
        rgba(18, 166, 216, 0.12),
        transparent 30%
      ),
      linear-gradient(135deg, #f5fbfd, #ffffff);
  }

  .section-label {
    color: var(--blue);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  .page-hero h1 {
    margin-top: 15px;
    font-family: "Manrope", sans-serif;
    font-size: clamp(42px, 6vw, 68px);
    line-height: 1.05;
    letter-spacing: -3px;
  }

  .page-hero h1 span,
  h2 span {
    color: var(--blue);
  }

  .page-hero p {
    max-width: 650px;
    margin-top: 22px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.8;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 22px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
  }

  .btn-primary {
    background: var(--blue);
    color: white;
    box-shadow: 0 10px 25px rgba(7, 89, 133, 0.2);
  }

  .btn-primary:hover {
    background: var(--blue-dark);
  }

  .page-actions {
    display: flex;
    gap: 12px;
    margin-top: 30px;
    flex-wrap: wrap;
  }

  /* CARDS */

  .card-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 50px;
  }

  .card {
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 25px;
    background: white;
    transition: 0.25s;
  }

  .card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow);
    border-color: #9ed8eb;
  }

  .card-icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    background: var(--blue-light);
    border-radius: 12px;
    font-size: 22px;
  }

  .card h3 {
    margin-top: 25px;
    font-family: "Manrope", sans-serif;
    font-size: 18px;
  }

  .card p {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.7;
    margin-top: 8px;
  }

  /* PRICE */

  .price-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-top: 45px;
  }

  .price-card {
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
  }

  .price-title {
    padding: 20px;
    background: var(--off);
    border-bottom: 1px solid var(--line);
    font-family: "Manrope", sans-serif;
    font-weight: 700;
    font-size: 15px;
  }

  .price-row {
    min-height: 58px;
    padding: 12px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    border-bottom: 1px solid #edf2f4;
  }

  .price-row:last-child {
    border-bottom: none;
  }

  .price-row:hover {
    background: #f5fbfd;
  }

  .price-row span {
    color: #4c606c;
    font-size: 11px;
  }

  .price-row strong {
    color: var(--blue);
    font-size: 12px;
    white-space: nowrap;
  }

  .info-box {
    padding: 25px;
    border-radius: 12px;
    background: var(--blue-light);
    margin-top: 25px;
    color: #54707e;
    font-size: 12px;
  }

  /* CONTENT */

  .dark-section {
    background: var(--blue-dark);
    color: white;
  }

  .dark-section .section-label {
    color: #72d9f8;
  }

  .two-column {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 80px;
    align-items: start;
  }

  h2 {
    font-family: "Manrope", sans-serif;
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1.08;
    letter-spacing: -2px;
    margin-top: 14px;
  }

  .content-text {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.9;
    margin-top: 22px;
  }

  .dark-section .content-text {
    color: #a5bbc5;
  }

  .list {
    margin-top: 25px;
    display: grid;
    gap: 12px;
  }

  .list div {
    font-size: 13px;
  }

  .list span {
    color: #11a665;
    margin-right: 8px;
  }

  .area-box {
    margin-top: 45px;
    padding: 35px;
    border-radius: 16px;
    background: var(--blue-light);
  }

  .area-box strong {
    display: block;
    margin-top: 5px;
    font-family: "Manrope", sans-serif;
    font-size: 24px;
  }

  .area-box p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 13px;
  }

  /* FAQ */

  .faq-list {
    margin-top: 35px;
  }

  details {
    border-bottom: 1px solid var(--line);
  }

  details:first-child {
    border-top: 1px solid var(--line);
  }

  summary {
    min-height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
    font-size: 13px;
    font-weight: 700;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  details p {
    padding: 0 30px 22px 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
  }

  /* CTA */

  .cta {
    padding: 70px 0;
    background:
      radial-gradient(
        circle at 85% 30%,
        rgba(18, 166, 216, 0.25),
        transparent 30%
      ),
      var(--blue);
    color: white;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .cta h2 {
    margin-top: 10px;
  }

  .cta-button {
    min-width: 270px;
    padding: 20px;
    border-radius: 10px;
    background: white;
    color: var(--blue-dark);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  /* FOOTER */

  footer {
    background: #031f2f;
    color: white;
    padding: 65px 0 25px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 70px;
  }

  .footer-brand p {
    max-width: 330px;
    margin-top: 20px;
    color: #829aa6;
    font-size: 12px;
  }

  footer h4 {
    color: #73c7e5;
    font-size: 10px;
    letter-spacing: 1.5px;
    margin-bottom: 18px;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .footer-column a,
  .footer-column span {
    color: #a5b9c2;
    font-size: 11px;
  }

  .footer-column a:hover {
    color: white;
  }

  .copyright {
    display: flex;
    justify-content: space-between;
    margin-top: 55px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: #627d89;
    font-size: 9px;
  }

  /* WHATSAPP */

  .floating-wa {
    width: 58px;
    height: 58px;
    display: grid;
    place-items: center;
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 90;
    border-radius: 50%;
    background: #12a665;
    color: white;
    box-shadow: 0 10px 30px rgba(18, 166, 101, 0.3);
    font-size: 12px;
    font-weight: 800;
    border: 3px solid white;
  }

  .floating-wa:hover {
    transform: translateY(-3px);
  }

  /* RESPONSIVE */

  @media (max-width: 1050px) {
    .desktop-nav {
      gap: 12px;
    }

    .desktop-nav a {
      font-size: 10px;
    }
  }

  @media (max-width: 900px) {
    .desktop-nav {
      display: none;
    }

    .mobile-menu {
      display: block;
    }

    .nav-cta {
      margin-left: auto;
    }

    .card-grid {
      grid-template-columns: 1fr 1fr;
    }

    .two-column {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 700px) {
    .container {
      width: calc(100% - 28px);
    }

    .navbar {
      min-height: 70px;
    }

    .nav-cta {
      display: none;
    }

    .page-hero {
      padding: 65px 0;
    }

    .page-hero h1 {
      font-size: 44px;
    }

    .section {
      padding: 75px 0;
    }

    .card-grid,
    .price-grid {
      grid-template-columns: 1fr;
    }

    .cta-inner {
      align-items: flex-start;
      flex-direction: column;
    }

    .cta-button {
      width: 100%;
      min-width: 0;
    }

    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 35px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .brand strong {
      font-size: 13px;
    }

    .brand small {
      font-size: 7px;
    }

    .page-hero h1 {
      font-size: 40px;
      letter-spacing: -2px;
    }

    .card-grid,
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-brand {
      grid-column: auto;
    }

    .price-row {
      padding: 13px 15px;
    }

    .price-row span {
      max-width: 62%;
    }

    .floating-wa {
      width: 52px;
      height: 52px;
      right: 15px;
      bottom: 15px;
    }

    .copyright {
      flex-direction: column;
      gap: 5px;
    }
  }
</style>