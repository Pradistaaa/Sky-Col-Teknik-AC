---
import MainLayout from "../layouts/MainLayout.astro";
import { faqs, whatsapp } from "../lib/data.js";
---

<MainLayout
  title="FAQ | Sky Col Teknik AC"
  description="Pertanyaan yang sering ditanyakan mengenai layanan Sky Col Teknik AC di DKI Jakarta."
>
  <section class="page-hero">
    <div class="container">
      <span class="section-label">FAQ</span>

      <h1>
        Pertanyaan yang
        <span>sering ditanyakan.</span>
      </h1>

      <p>
        Temukan informasi mengenai layanan, area, booking,
        dan kebutuhan service AC bersama Sky Col Teknik AC.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container faq-layout">
      <div class="faq-intro">
        <span class="section-label">INFORMASI</span>

        <h2>
          Masih punya
          <span>pertanyaan?</span>
        </h2>

        <p>
          Jika informasi yang Anda cari belum tersedia,
          silakan hubungi Sky Col Teknik AC melalui WhatsApp.
        </p>

        <a
          class="faq-button"
          href={whatsapp("menanyakan informasi service AC")}
          target="_blank"
          rel="noopener noreferrer"
        >
          Tanya melalui WhatsApp
          <span>↗</span>
        </a>
      </div>

      <div class="faq-list">
        {
          faqs.map((faq, index) => (
            <details class="faq-item" open={index === 0}>
              <summary>
                <span>{faq.question}</span>
                <b>+</b>
              </summary>

              <div class="faq-answer">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="dark-section">
    <div class="container">
      <div class="dark-content">
        <div>
          <span class="section-label">SKY COL TEKNIK AC</span>

          <h2>
            Belum menemukan
            <span>jawaban yang dicari?</span>
          </h2>

          <p>
            Sampaikan kebutuhan atau kendala AC Anda secara
            langsung melalui WhatsApp.
          </p>
        </div>

        <a
          class="dark-button"
          href={whatsapp()}
          target="_blank"
          rel="noopener noreferrer"
        >
          <strong>0812 9798 3801</strong>
          <span>↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section final-section">
    <div class="container">
      <div class="final-box">
        <div>
          <span class="section-label">BUTUH SERVICE AC?</span>

          <h2>
            Konsultasikan kebutuhan
            <span>AC Anda.</span>
          </h2>
        </div>

        <div class="final-links">
          <a href="/layanan">Lihat Layanan</a>
          <a href="/harga">Lihat Harga</a>
          <a
            href={whatsapp()}
            target="_blank"
            rel="noopener noreferrer"
            class="primary-link"
          >
            Hubungi WhatsApp ↗
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .page-hero {
    padding: 90px 0 80px;
    background:
      radial-gradient(
        circle at 85% 20%,
        rgba(37, 99, 235, 0.12),
        transparent 35%
      ),
      #f8fbff;
  }

  .page-hero h1 {
    max-width: 760px;
    margin: 18px 0 0;
    color: #0f172a;
    font-size: clamp(42px, 6vw, 68px);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .page-hero h1 span {
    display: block;
    color: #2563eb;
  }

  .page-hero p {
    max-width: 650px;
    margin-top: 24px;
    color: #64748b;
    font-size: 17px;
    line-height: 1.8;
  }

  .faq-layout {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: 90px;
    align-items: start;
  }

  .faq-intro {
    position: sticky;
    top: 110px;
  }

  .faq-intro h2 {
    margin-top: 14px;
  }

  .faq-intro h2 span {
    display: block;
    color: #2563eb;
  }

  .faq-intro p {
    max-width: 380px;
    margin-top: 18px;
    color: #64748b;
    line-height: 1.8;
  }

  .faq-button {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    margin-top: 25px;
    padding: 15px 19px;
    border-radius: 12px;
    background: #2563eb;
    color: #ffffff;
    font-size: 14px;
    font-weight: 800;
    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .faq-button:hover {
    transform: translateY(-2px);
    background: #1d4ed8;
  }

  .faq-button span {
    font-size: 18px;
  }

  .faq-list {
    display: grid;
    gap: 14px;
  }

  .faq-item {
    overflow: hidden;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    background: #ffffff;
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    padding: 23px 25px;
    cursor: pointer;
    list-style: none;
    color: #0f172a;
    font-size: 16px;
    font-weight: 800;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary b {
    flex-shrink: 0;
    color: #2563eb;
    font-size: 24px;
    font-weight: 400;
    transition: transform 0.2s ease;
  }

  .faq-item[open] summary b {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 25px 25px;
  }

  .faq-answer p {
    margin: 0;
    color: #64748b;
    font-size: 15px;
    line-height: 1.8;
  }

  .dark-section {
    padding: 90px 0;
    background: #0f172a;
    color: #ffffff;
  }

  .dark-section .section-label {
    color: #60a5fa;
  }

  .dark-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 50px;
  }

  .dark-content h2 {
    max-width: 650px;
    margin-top: 14px;
    color: #ffffff;
  }

  .dark-content h2 span {
    display: block;
    color: #60a5fa;
  }

  .dark-content p {
    max-width: 560px;
    margin-top: 18px;
    color: #94a3b8;
    line-height: 1.8;
  }

  .dark-button {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 18px 22px;
    border-radius: 14px;
    background: #ffffff;
    color: #0f172a;
    white-space: nowrap;
  }

  .dark-button span {
    color: #2563eb;
    font-size: 20px;
  }

  .final-section {
    padding-bottom: 100px;
  }

  .final-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    padding: 50px;
    border: 1px solid #dbeafe;
    border-radius: 24px;
    background: #eff6ff;
  }

  .final-box h2 {
    margin-top: 12px;
  }

  .final-box h2 span {
    display: block;
    color: #2563eb;
  }

  .final-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
  }

  .final-links a {
    padding: 13px 17px;
    border: 1px solid #bfdbfe;
    border-radius: 10px;
    background: #ffffff;
    color: #2563eb;
    font-size: 13px;
    font-weight: 800;
  }

  .final-links .primary-link {
    border-color: #2563eb;
    background: #2563eb;
    color: #ffffff;
  }

  @media (max-width: 850px) {
    .faq-layout {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .faq-intro {
      position: static;
    }

    .dark-content,
    .final-box {
      flex-direction: column;
      align-items: flex-start;
    }

    .final-links {
      justify-content: flex-start;
    }
  }

  @media (max-width: 600px) {
    .page-hero {
      padding: 60px 0;
    }

    .page-hero h1 {
      font-size: 43px;
    }

    .page-hero p {
      font-size: 15px;
    }

    .faq-item summary {
      padding: 20px;
      font-size: 15px;
    }

    .faq-answer {
      padding: 0 20px 20px;
    }

    .dark-button {
      width: 100%;
      justify-content: space-between;
    }

    .final-box {
      padding: 30px 24px;
    }

    .final-links {
      width: 100%;
      flex-direction: column;
    }

    .final-links a {
      width: 100%;
      text-align: center;
    }
  }
</style>