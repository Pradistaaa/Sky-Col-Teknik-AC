---
import MainLayout from "../layouts/MainLayout.astro";
import { services, whatsapp } from "../lib/data.js";
---

<MainLayout
  title="Sky Col Teknik AC | Service AC DKI Jakarta"
  description="Sky Col Teknik AC melayani service, cuci AC, freon, bongkar pasang, dan perbaikan AC di DKI Jakarta."
>

  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">

      <div class="hero-content">
        <span class="hero-label">SERVICE AC DKI JAKARTA</span>

        <h1>
          AC Bermasalah?
          <span>Kami Siap Membantu.</span>
        </h1>

        <p>
          Sky Col Teknik AC melayani service, cuci AC, freon,
          bongkar pasang, hingga perbaikan AC untuk rumah,
          kantor, toko, dan tempat usaha.
        </p>

        <div class="hero-actions">
          <a
            class="btn btn-primary"
            href={whatsapp()}
            target="_blank"
            rel="noopener noreferrer"
          >
            Booking via WhatsApp ↗
          </a>

          <a class="btn btn-outline" href="/harga">
            Lihat Daftar Harga
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="ac-card">
          <div class="ac-top"></div>
          <div class="ac-display">24°</div>
          <div class="ac-line"></div>
          <div class="ac-line short"></div>
        </div>

        <div class="floating-card">
          <strong>27+</strong>
          <span>Layanan AC</span>
        </div>
      </div>

    </div>
  </section>


  <!-- TRUST -->
  <section class="trust">
    <div class="container">

      <div class="trust-grid">

        <div class="trust-item">
          <strong>27+</strong>
          <span>Layanan AC</span>
        </div>

        <div class="trust-item">
          <strong>DKI</strong>
          <span>Area Layanan</span>
        </div>

        <div class="trust-item">
          <strong>WA</strong>
          <span>Respon Langsung</span>
        </div>

        <div class="trust-item">
          <strong>AC</strong>
          <span>Rumah & Usaha</span>
        </div>

      </div>

    </div>
  </section>


  <!-- SERVICES -->
  <section class="section">
    <div class="container">

      <div class="section-heading">
        <div>
          <span class="section-label">LAYANAN KAMI</span>

          <h2>
            Solusi lengkap
            <span>untuk kebutuhan AC.</span>
          </h2>
        </div>

        <a class="text-link" href="/layanan">
          Lihat semua layanan →
        </a>
      </div>

      <div class="service-grid">

        {services.map((service, index) => (
          <a
            class="service-card"
            href={whatsapp(service.title.toLowerCase())}
            target="_blank"
            rel="noopener noreferrer"
          >

            <div class="service-top">
              <span class="service-number">
                {String(index + 1).padStart(2, "0")}
              </span>

              <span class="service-arrow">↗</span>
            </div>

            <div class="service-icon">
              {index === 0 && "❄"}
              {index === 1 && "◈"}
              {index === 2 && "⌂"}
              {index === 3 && "⚙"}
            </div>

            <h3>{service.title}</h3>

            <p>{service.description}</p>

            <span class="service-link">
              Konsultasi layanan →
            </span>

          </a>
        ))}

      </div>

    </div>
  </section>


  <!-- WHY US -->
  <section class="dark-section">
    <div class="container two-column">

      <div>
        <span class="section-label light">
          KENAPA SKY COL?
        </span>

        <h2>
          Layanan AC yang
          <span>jelas dan mudah.</span>
        </h2>

        <p class="dark-description">
          Berbagai kebutuhan service AC tersedia dalam satu layanan,
          dengan informasi harga yang dapat dilihat sebelum melakukan
          booking.
        </p>
      </div>

      <div class="feature-list">

        <div class="feature-item">
          <span>01</span>
          <div>
            <strong>Layanan AC Lengkap</strong>
            <p>
              Berbagai kebutuhan AC tersedia dalam satu layanan.
            </p>
          </div>
        </div>

        <div class="feature-item">
          <span>02</span>
          <div>
            <strong>Harga Transparan</strong>
            <p>
              Daftar harga tersedia agar pelanggan dapat mengetahui
              estimasi biaya layanan.
            </p>
          </div>
        </div>

        <div class="feature-item">
          <span>03</span>
          <div>
            <strong>Area DKI Jakarta</strong>
            <p>
              Melayani kebutuhan service AC untuk pelanggan di wilayah
              DKI Jakarta.
            </p>
          </div>
        </div>

        <div class="feature-item">
          <span>04</span>
          <div>
            <strong>Mudah Booking</strong>
            <p>
              Konsultasi dan pemesanan layanan dapat dilakukan melalui
              WhatsApp.
            </p>
          </div>
        </div>

      </div>

    </div>
  </section>


  <!-- AREA -->
  <section class="section">
    <div class="container">

      <div class="area-box">

        <div>
          <span class="section-label">AREA LAYANAN</span>

          <h2>
            Melayani kebutuhan AC di
            <span>DKI Jakarta.</span>
          </h2>

          <p>
            Hubungi kami untuk mengetahui ketersediaan layanan
            di lokasi Anda.
          </p>
        </div>

        <a
          class="btn btn-primary"
          href={whatsapp("menanyakan ketersediaan layanan AC")}
          target="_blank"
          rel="noopener noreferrer"
        >
          Tanya via WhatsApp ↗
        </a>

      </div>

    </div>
  </section>


  <!-- CTA -->
  <section class="cta">
    <div class="container cta-inner">

      <div>
        <span>SKY COL TEKNIK AC</span>

        <h2>
          AC bermasalah?<br />
          <strong>Jangan tunggu sampai parah.</strong>
        </h2>
      </div>

      <a
        class="cta-button"
        href={whatsapp()}
        target="_blank"
        rel="noopener noreferrer"
      >
        <strong>0812 9798 3801</strong>
        <b>↗</b>
      </a>

    </div>
  </section>

</MainLayout>


<style>
  .hero {
    padding: 90px 0 80px;
    background:
      radial-gradient(circle at 85% 20%, rgba(37, 99, 235, 0.13), transparent 35%),
      #f8fbff;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 70px;
  }

  .hero-label {
    display: inline-flex;
    margin-bottom: 22px;
    padding: 8px 14px;
    border: 1px solid #bfdbfe;
    border-radius: 999px;
    background: #eff6ff;
    color: #2563eb;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .hero h1 {
    max-width: 720px;
    margin: 0;
    color: #0f172a;
    font-size: clamp(42px, 6vw, 72px);
    line-height: 1.03;
    letter-spacing: -0.045em;
  }

  .hero h1 span {
    display: block;
    color: #2563eb;
  }

  .hero p {
    max-width: 650px;
    margin: 26px 0 0;
    color: #64748b;
    font-size: 17px;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .btn-outline {
    border: 1px solid #dbe3ef;
    background: #ffffff;
    color: #0f172a;
  }

  .btn-outline:hover {
    border-color: #2563eb;
    color: #2563eb;
  }

  .hero-visual {
    position: relative;
    min-height: 390px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ac-card {
    width: 300px;
    height: 170px;
    padding: 28px;
    border-radius: 22px;
    background: linear-gradient(145deg, #ffffff, #e8f1ff);
    border: 1px solid #dbeafe;
    box-shadow: 0 30px 70px rgba(15, 23, 42, 0.14);
    transform: perspective(700px) rotateY(-12deg) rotateX(5deg);
  }

  .ac-top {
    width: 90px;
    height: 6px;
    margin-bottom: 35px;
    border-radius: 10px;
    background: #cbd5e1;
  }

  .ac-display {
    width: 48px;
    padding: 5px 8px;
    border-radius: 6px;
    background: #0f172a;
    color: #67e8f9;
    font-size: 12px;
    text-align: center;
  }

  .ac-line {
    width: 100%;
    height: 4px;
    margin-top: 30px;
    border-radius: 10px;
    background: #cbd5e1;
  }

  .ac-line.short {
    width: 65%;
    margin-top: 9px;
  }

  .floating-card {
    position: absolute;
    right: 5%;
    bottom: 25px;
    display: flex;
    flex-direction: column;
    padding: 18px 22px;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    background: #ffffff;
    box-shadow: 0 20px 45px rgba(15, 23, 42, 0.12);
  }

  .floating-card strong {
    color: #2563eb;
    font-size: 30px;
    line-height: 1;
  }

  .floating-card span {
    margin-top: 5px;
    color: #64748b;
    font-size: 12px;
  }

  .trust {
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
    background: #ffffff;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .trust-item {
    padding: 26px 20px;
    text-align: center;
    border-right: 1px solid #e2e8f0;
  }

  .trust-item:last-child {
    border-right: 0;
  }

  .trust-item strong {
    display: block;
    color: #0f172a;
    font-size: 24px;
  }

  .trust-item span {
    display: block;
    margin-top: 4px;
    color: #64748b;
    font-size: 13px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 42px;
  }

  .text-link {
    color: #2563eb;
    font-size: 14px;
    font-weight: 800;
    white-space: nowrap;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    min-height: 310px;
    padding: 26px;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    background: #ffffff;
    transition: 0.25s ease;
  }

  .service-card:hover {
    border-color: #93c5fd;
    transform: translateY(-5px);
    box-shadow: 0 20px 45px rgba(15, 23, 42, 0.08);
  }

  .service-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .service-number {
    color: #94a3b8;
    font-size: 12px;
    font-weight: 800;
  }

  .service-arrow {
    color: #2563eb;
    font-size: 20px;
  }

  .service-icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    margin: 30px 0 22px;
    border-radius: 14px;
    background: #eff6ff;
    color: #2563eb;
    font-size: 21px;
  }

  .service-card h3 {
    margin: 0;
    color: #0f172a;
    font-size: 19px;
  }

  .service-card p {
    margin: 12px 0 0;
    color: #64748b;
    font-size: 14px;
    line-height: 1.7;
  }

  .service-link {
    margin-top: auto;
    padding-top: 22px;
    color: #2563eb;
    font-size: 13px;
    font-weight: 800;
  }

  .dark-section {
    padding: 90px 0;
    background: #0f172a;
    color: #ffffff;
  }

  .dark-section .section-label {
    color: #60a5fa;
  }

  .dark-section h2 {
    max-width: 560px;
    color: #ffffff;
  }

  .dark-section h2 span {
    display: block;
    color: #60a5fa;
  }

  .dark-description {
    max-width: 540px;
    margin-top: 24px;
    color: #94a3b8;
    line-height: 1.8;
  }

  .feature-list {
    display: grid;
    gap: 10px;
  }

  .feature-item {
    display: grid;
    grid-template-columns: 45px 1fr;
    gap: 18px;
    padding: 22px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .feature-item > span {
    color: #60a5fa;
    font-size: 13px;
    font-weight: 800;
  }

  .feature-item strong {
    font-size: 16px;
  }

  .feature-item p {
    margin: 7px 0 0;
    color: #94a3b8;
    font-size: 14px;
    line-height: 1.6;
  }

  .area-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    padding: 55px;
    border: 1px solid #dbeafe;
    border-radius: 24px;
    background: #eff6ff;
  }

  .area-box h2 {
    margin-top: 10px;
  }

  .area-box h2 span {
    display: block;
    color: #2563eb;
  }

  .area-box p {
    margin: 16px 0 0;
    color: #64748b;
  }

  .cta {
    padding: 75px 0;
    background: #2563eb;
    color: #ffffff;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .cta-inner > div > span {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    opacity: 0.75;
  }

  .cta h2 {
    margin-top: 12px;
    color: #ffffff;
  }

  .cta h2 strong {
    color: #dbeafe;
  }

  .cta-button {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 18px 22px;
    border-radius: 14px;
    background: #ffffff;
    color: #0f172a;
    white-space: nowrap;
  }

  .cta-button b {
    color: #2563eb;
    font-size: 20px;
  }

  @media (max-width: 1000px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-visual {
      min-height: 300px;
    }

    .service-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 700px) {
    .hero {
      padding: 60px 0;
    }

    .hero h1 {
      font-size: 43px;
    }

    .hero p {
      font-size: 15px;
    }

    .hero-actions {
      flex-direction: column;
    }

    .hero-actions .btn {
      width: 100%;
      text-align: center;
    }

    .hero-visual {
      min-height: 250px;
    }

    .ac-card {
      width: 245px;
      height: 140px;
    }

    .floating-card {
      right: 0;
      bottom: 5px;
    }

    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .trust-item:nth-child(2) {
      border-right: 0;
    }

    .trust-item:nth-child(-n + 2) {
      border-bottom: 1px solid #e2e8f0;
    }

    .section-heading {
      display: block;
    }

    .text-link {
      display: inline-block;
      margin-top: 18px;
    }

    .service-grid {
      grid-template-columns: 1fr;
    }

    .two-column {
      grid-template-columns: 1fr;
    }

    .area-box {
      flex-direction: column;
      align-items: flex-start;
      padding: 32px 24px;
    }

    .area-box .btn {
      width: 100%;
      text-align: center;
    }

    .cta-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .cta-button {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>