---
const waNumber = "6281297983801";

const services = [
  {
    icon: "❄️",
    title: "Service & Cuci AC",
    desc: "Perawatan AC agar tetap bersih, dingin, dan bekerja optimal.",
  },
  {
    icon: "🧊",
    title: "Freon AC",
    desc: "Tambah atau isi freon sesuai jenis refrigerant dan kapasitas AC.",
  },
  {
    icon: "🔧",
    title: "Bongkar & Pasang",
    desc: "Jasa bongkar, pasang, dan bongkar pasang AC rumah maupun usaha.",
  },
  {
    icon: "⚙️",
    title: "Perbaikan AC",
    desc: "Pengecekan dan perbaikan berbagai masalah pada unit AC.",
  },
];

const priceGroups = [
  {
    title: "Service & Cuci AC",
    items: [
      ["Service Cuci AC 0.5–1 PK", "Rp75.000"],
      ["Service Cuci AC 1.5–2 PK", "Rp85.000"],
      ["Service Cuci AC Inverter", "Rp135.000"],
    ],
  },
  {
    title: "Tambah & Isi Freon",
    items: [
      ["Tambah Freon R22 0.5–1 PK", "Rp250.000"],
      ["Tambah Freon R22 1.5–2 PK", "Rp300.000"],
      ["Tambah Freon R32/R410 0.5–1 PK", "Rp250.000"],
      ["Tambah Freon R32/R410 1.5–2 PK", "Rp250.000"],
      ["Isi Freon R22 0.5–1 PK", "Rp350.000"],
      ["Isi Freon R22 1.5–2 PK", "Rp450.000"],
      ["Isi Freon R32/R410 0.5–1 PK", "Rp350.000"],
      ["Isi Freon R32/R410 1.5–2 PK", "Rp450.000"],
    ],
  },
  {
    title: "Bongkar & Pasang AC",
    items: [
      ["Bongkar AC", "Rp200.000"],
      ["Pasang AC 0.5–1 PK", "Rp350.000"],
      ["Pasang AC 1.5–2 PK", "Rp400.000"],
      ["Bongkar Pasang AC 0.5–1 PK", "Rp475.000"],
      ["Bongkar Pasang AC 1.5–2 PK", "Rp575.000"],
    ],
  },
  {
    title: "Perbaikan & Komponen",
    items: [
      ["Penggantian Kapasitor AC 0.5–1 PK", "Rp375.000"],
      ["Penggantian Kapasitor AC 1.5–2 PK", "Rp425.000"],
      ["Harga Bobok Tembok per Titik", "Rp50.000"],
      ["Jasa Las per Titik", "Rp125.000"],
      ["Vakum AC", "Rp275.000"],
      ["Flushing AC", "Rp225.000"],
      ["Vakum dan Flushing", "Rp475.000"],
      ["Biaya Pengecekan AC", "Rp100.000"],
      ["Perbaikan Kebocoran Pipa Beringan Nepel", "Rp395.000"],
      ["Oli Kompresor AC", "Rp375.000"],
      ["Pergantian Pentil Sill Nepel", "Rp175.000"],
    ],
  },
];

const faqs = [
  {
    q: "Apakah Sky Col Teknik AC melayani panggilan?",
    a: "Ya. Sky Col Teknik AC melayani kebutuhan service AC dengan sistem panggilan di area DKI Jakarta.",
  },
  {
    q: "Apakah bisa service AC inverter?",
    a: "Bisa. Tersedia layanan service cuci AC inverter dengan harga yang tercantum pada daftar layanan.",
  },
  {
    q: "Apakah bisa bongkar dan pasang AC?",
    a: "Bisa. Tersedia layanan bongkar, pasang, maupun bongkar pasang berdasarkan kapasitas AC.",
  },
  {
    q: "Bagaimana cara melakukan booking?",
    a: "Hubungi Sky Col Teknik AC melalui WhatsApp, sampaikan kebutuhan dan lokasi, kemudian teknisi akan membantu proses selanjutnya.",
  },
];

function whatsapp(service = "konsultasi service AC") {
  return `https://wa.me/${waNumber}?text=${encodeURIComponent(
    `Halo Sky Col Teknik AC, saya ingin ${service}. Mohon informasinya.`
  )}`;
}
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Sky Col Teknik AC - Jasa service, cuci, isi freon, bongkar pasang dan perbaikan AC di DKI Jakarta." />
    <meta name="theme-color" content="#075985" />
    <title>Sky Col Teknik AC | Service AC DKI Jakarta</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>

    <!-- NAVBAR -->
    <header class="navbar">
      <div class="container nav-inner">
        <a href="#home" class="brand">
          <span class="brand-icon">✦</span>
          <span>
            <strong>SKY COL</strong>
            <small>TEKNIK AC</small>
          </span>
        </a>

        <nav>
          <a href="#layanan">Layanan</a>
          <a href="#harga">Harga</a>
          <a href="#tentang">Tentang</a>
          <a href="#faq">FAQ</a>
        </nav>

        <a
          class="nav-button"
          href={whatsapp()}
          target="_blank"
          rel="noopener noreferrer"
        >
          Hubungi Kami
        </a>
      </div>
    </header>

    <main>

      <!-- HERO -->
      <section class="hero" id="home">
        <div class="hero-glow glow-one"></div>
        <div class="hero-glow glow-two"></div>

        <div class="container hero-grid">
          <div class="hero-content">
            <div class="eyebrow">
              <span class="dot"></span>
              SERVICE AC DKI JAKARTA
            </div>

            <h1>
              AC Bermasalah?
              <span>Kami Siap Membantu.</span>
            </h1>

            <p>
              Sky Col Teknik AC melayani service, cuci AC, freon,
              bongkar pasang, hingga perbaikan AC untuk rumah,
              kantor, toko, dan tempat usaha.
            </p>

            <div class="hero-actions">
              <a
                class="btn btn-primary"
                href={whatsapp()}
                target="_blank"
                rel="noopener noreferrer"
              >
                Booking via WhatsApp <span>↗</span>
              </a>

              <a class="btn btn-outline" href="#harga">
                Lihat Daftar Harga
              </a>
            </div>

            <div class="hero-info">
              <div>
                <strong>27+</strong>
                <span>Layanan AC</span>
              </div>
              <div>
                <strong>DKI</strong>
                <span>Area Layanan</span>
              </div>
              <div>
                <strong>WA</strong>
                <span>Respon Langsung</span>
              </div>
            </div>
          </div>

          <div class="hero-card">
            <div class="hero-card-top">
              <span>SKY COL</span>
              <span>01</span>
            </div>

            <div class="ac-illustration">
              <div class="ac-unit">
                <div class="ac-display">24°</div>
                <div class="ac-line"></div>
                <div class="air air-one"></div>
                <div class="air air-two"></div>
                <div class="air air-three"></div>
              </div>
            </div>

            <div class="hero-card-bottom">
              <span>TEKNISI AC</span>
              <strong>DKI JAKARTA</strong>
            </div>
          </div>
        </div>
      </section>

      <!-- TRUST BAR -->
      <section class="trust">
        <div class="container trust-inner">
          <span>LAYANAN UNTUK</span>
          <div>Rumah</div>
          <div>Kantor</div>
          <div>Toko</div>
          <div>Ruko</div>
          <div>Tempat Usaha</div>
        </div>
      </section>

      <!-- SERVICES -->
      <section class="section" id="layanan">
        <div class="container">
          <div class="section-heading">
            <div>
              <span class="section-label">LAYANAN KAMI</span>
              <h2>Solusi lengkap<br /><span>untuk kebutuhan AC.</span></h2>
            </div>

            <p>
              Dari perawatan rutin hingga perbaikan,
              Sky Col Teknik AC siap membantu menjaga
              AC tetap bekerja dengan baik.
            </p>
          </div>

          <div class="service-grid">
            {services.map((service, index) => (
              <a
                class="service-card"
                href={whatsapp(service.title.toLowerCase())}
                target="_blank"
                rel="noopener noreferrer"
              >
                <div class="service-number">0{index + 1}</div>
                <div class="service-icon">{service.icon}</div>
                <h3>{service.title}</h3>
                <p>{service.desc}</p>
                <span class="service-link">Pesan layanan →</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- ABOUT -->
      <section class="about section" id="tentang">
        <div class="container about-grid">
          <div class="about-visual">
            <div class="about-box">
              <span>SKY COL</span>
              <strong>TEKNIK<br />AC</strong>
              <small>DKI JAKARTA</small>
            </div>
          </div>

          <div class="about-content">
            <span class="section-label">TENTANG KAMI</span>
            <h2>
              Perawatan AC yang tepat,
              <span>membuat ruangan tetap nyaman.</span>
            </h2>

            <p>
              Sky Col Teknik AC hadir untuk membantu kebutuhan
              perawatan dan perbaikan AC di wilayah DKI Jakarta.
            </p>

            <p>
              Kami menyediakan berbagai layanan mulai dari cuci AC,
              pengisian freon, bongkar pasang, pengecekan,
              hingga kebutuhan perbaikan dan komponen AC.
            </p>

            <div class="check-list">
              <div><span>✓</span> Layanan AC lengkap</div>
              <div><span>✓</span> Melayani area DKI Jakarta</div>
              <div><span>✓</span> Booking melalui WhatsApp</div>
              <div><span>✓</span> Harga layanan transparan</div>
            </div>
          </div>
        </div>
      </section>

      <!-- PRICE -->
      <section class="section price-section" id="harga">
        <div class="container">
          <div class="section-heading centered">
            <span class="section-label">DAFTAR HARGA</span>
            <h2>Layanan & <span>harga.</span></h2>
            <p>
              Pilih kebutuhan AC Anda dan hubungi kami untuk
              melakukan booking atau konsultasi.
            </p>
          </div>

          <div class="price-grid">
            {priceGroups.map((group) => (
              <div class="price-card">
                <div class="price-title">
                  <span></span>
                  <h3>{group.title}</h3>
                </div>

                <div class="price-list">
                  {group.items.map(([name, price]) => (
                    <a
                      href={whatsapp(name.toLowerCase())}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="price-row"
                    >
                      <span>{name}</span>
                      <strong>{price}</strong>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <div class="price-note">
            <span>ⓘ</span>
            <p>
              Harga layanan mengikuti daftar yang tersedia.
              Untuk kondisi khusus atau kebutuhan tambahan,
              silakan konsultasikan terlebih dahulu melalui WhatsApp.
            </p>
          </div>
        </div>
      </section>

      <!-- WHY US -->
      <section class="why section">
        <div class="container">
          <div class="why-inner">
            <div class="why-heading">
              <span class="section-label">KENAPA SKY COL?</span>
              <h2>
                Bukan sekadar<br />
                <span>service AC.</span>
              </h2>
            </div>

            <div class="why-list">
              <div class="why-item">
                <span>01</span>
                <div>
                  <h3>Layanan Lengkap</h3>
                  <p>
                    Berbagai kebutuhan AC tersedia dalam satu layanan.
                  </p>
                </div>
              </div>

              <div class="why-item">
                <span>02</span>
                <div>
                  <h3>Harga Transparan</h3>
                  <p>
                    Daftar harga tersedia agar pelanggan dapat mengetahui
                    estimasi biaya layanan.
                  </p>
                </div>
              </div>

              <div class="why-item">
                <span>03</span>
                <div>
                  <h3>Area DKI Jakarta</h3>
                  <p>
                    Melayani kebutuhan service AC untuk pelanggan
                    di wilayah DKI Jakarta.
                  </p>
                </div>
              </div>

              <div class="why-item">
                <span>04</span>
                <div>
                  <h3>Mudah Booking</h3>
                  <p>
                    Konsultasi dan pemesanan layanan dapat dilakukan
                    langsung melalui WhatsApp.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- PROCESS -->
      <section class="section">
        <div class="container">
          <div class="section-heading centered">
            <span class="section-label">CARA BOOKING</span>
            <h2>Semudah <span>3 langkah.</span></h2>
          </div>

          <div class="process-grid">
            <div class="process-card">
              <span>01</span>
              <h3>Hubungi Kami</h3>
              <p>
                Kirim pesan melalui WhatsApp dan sampaikan
                kebutuhan AC Anda.
              </p>
            </div>

            <div class="process-card">
              <span>02</span>
              <h3>Informasikan Lokasi</h3>
              <p>
                Berikan informasi lokasi dan jenis AC
                yang membutuhkan layanan.
              </p>
            </div>

            <div class="process-card">
              <span>03</span>
              <h3>Jadwalkan Service</h3>
              <p>
                Tentukan waktu layanan dan teknisi akan
                membantu kebutuhan AC Anda.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- AREA -->
      <section class="area">
        <div class="container area-inner">
          <div>
            <span class="section-label">AREA LAYANAN</span>
            <h2>Melayani kebutuhan AC<br /><span>di DKI Jakarta.</span></h2>
          </div>

          <div class="area-box">
            <span>📍</span>
            <div>
              <strong>DKI Jakarta</strong>
              <p>
                Hubungi kami untuk mengetahui ketersediaan
                layanan di lokasi Anda.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="section faq-section" id="faq">
        <div class="container faq-grid">
          <div class="faq-intro">
            <span class="section-label">FAQ</span>
            <h2>Pertanyaan yang<br /><span>sering ditanyakan.</span></h2>
            <p>
              Belum menemukan jawaban? Silakan langsung
              hubungi Sky Col Teknik AC melalui WhatsApp.
            </p>

            <a
              class="btn btn-primary"
              href={whatsapp()}
              target="_blank"
              rel="noopener noreferrer"
            >
              Tanya via WhatsApp ↗
            </a>
          </div>

          <div class="faq-list">
            {faqs.map((faq) => (
              <details>
                <summary>
                  {faq.q}
                  <span>+</span>
                </summary>
                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="cta">
        <div class="container cta-inner">
          <div>
            <span>SKY COL TEKNIK AC</span>
            <h2>
              AC bermasalah?<br />
              <strong>Jangan tunggu sampai parah.</strong>
            </h2>
          </div>

          <a
            href={whatsapp()}
            target="_blank"
            rel="noopener noreferrer"
            class="cta-button"
          >
            <span>WhatsApp</span>
            <strong>0812 9798 3801</strong>
            <b>↗</b>
          </a>
        </div>
      </section>

    </main>

    <!-- FOOTER -->
    <footer>
      <div class="container footer-grid">
        <div class="footer-brand">
          <a href="#home" class="brand">
            <span class="brand-icon">✦</span>
            <span>
              <strong>SKY COL</strong>
              <small>TEKNIK AC</small>
            </span>
          </a>

          <p>
            Solusi service dan perawatan AC
            untuk kebutuhan Anda di DKI Jakarta.
          </p>
        </div>

        <div>
          <h4>Navigasi</h4>
          <a href="#layanan">Layanan</a>
          <a href="#harga">Daftar Harga</a>
          <a href="#tentang">Tentang Kami</a>
          <a href="#faq">FAQ</a>
        </div>

        <div>
          <h4>Hubungi</h4>
          <a
            href={whatsapp()}
            target="_blank"
            rel="noopener noreferrer"
          >
            0812 9798 3801
          </a>
          <span>DKI Jakarta</span>
        </div>
      </div>

      <div class="container copyright">
        <span>© 2026 Sky Col Teknik AC</span>
        <span>Service AC • DKI Jakarta</span>
      </div>
    </footer>

    <!-- FLOATING WHATSAPP -->
    <a
      class="floating-wa"
      href={whatsapp()}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Hubungi Sky Col Teknik AC via WhatsApp"
    >
      <span>WA</span>
    </a>

  </body>
</html>

<style>
  :root {
    --blue: #075985;
    --blue-dark: #043b59;
    --blue-light: #eaf7fc;
    --cyan: #12a6d8;
    --ink: #10212d;
    --muted: #647783;
    --white: #ffffff;
    --off: #f5f9fb;
    --line: #dce8ed;
    --shadow: 0 20px 60px rgba(7, 89, 133, .12);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: "DM Sans", sans-serif;
    color: var(--ink);
    background: var(--white);
    line-height: 1.6;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .container {
    width: min(1160px, calc(100% - 40px));
    margin: auto;
  }

  /* NAVBAR */

  .navbar {
    height: 82px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(220, 232, 237, .8);
    background: rgba(255,255,255,.94);
    backdrop-filter: blur(15px);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .brand-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    background: var(--blue);
    color: white;
    border-radius: 10px;
    font-size: 19px;
  }

  .brand strong {
    display: block;
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    line-height: 1;
    letter-spacing: 1.4px;
  }

  .brand small {
    display: block;
    margin-top: 4px;
    color: var(--blue);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  nav a {
    color: #566975;
    font-size: 13px;
    font-weight: 600;
    transition: .2s;
  }

  nav a:hover {
    color: var(--blue);
  }

  .nav-button {
    background: var(--blue);
    color: white;
    padding: 12px 19px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
  }

  /* HERO */

  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 80% 20%, rgba(18,166,216,.12), transparent 28%),
      linear-gradient(135deg, #f5fbfd 0%, #ffffff 60%);
    padding: 90px 0 85px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    align-items: center;
    gap: 80px;
    position: relative;
    z-index: 2;
  }

  .eyebrow,
  .section-label {
    color: var(--blue);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
  }

  .dot {
    width: 7px;
    height: 7px;
    background: #19b76a;
    border-radius: 50%;
    box-shadow: 0 0 0 5px rgba(25,183,106,.1);
  }

  .hero h1 {
    max-width: 700px;
    font-family: "Manrope", sans-serif;
    font-size: clamp(44px, 5.4vw, 76px);
    line-height: 1.04;
    letter-spacing: -3px;
  }

  .hero h1 span {
    color: var(--blue);
    display: block;
  }

  .hero-content > p {
    max-width: 610px;
    margin-top: 25px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    min-height: 50px;
    padding: 0 22px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
  }

  .btn-primary {
    background: var(--blue);
    color: white;
    box-shadow: 0 10px 25px rgba(7,89,133,.2);
  }

  .btn-outline {
    border: 1px solid var(--line);
    background: white;
    color: var(--ink);
  }

  .hero-info {
    display: flex;
    gap: 35px;
    margin-top: 48px;
  }

  .hero-info div {
    display: flex;
    flex-direction: column;
  }

  .hero-info strong {
    font-family: "Manrope", sans-serif;
    font-size: 20px;
    color: var(--blue-dark);
  }

  .hero-info span {
    color: #83939c;
    font-size: 10px;
    margin-top: 2px;
  }

  .hero-card {
    min-height: 475px;
    border-radius: 22px;
    background:
      linear-gradient(145deg, #074e72, #062e45);
    color: white;
    box-shadow: 0 35px 80px rgba(4,59,89,.2);
    padding: 25px;
    position: relative;
    overflow: hidden;
  }

  .hero-card::before {
    content: "";
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: rgba(18,166,216,.16);
    right: -90px;
    top: -80px;
  }

  .hero-card-top,
  .hero-card-bottom {
    display: flex;
    justify-content: space-between;
    position: relative;
    z-index: 2;
