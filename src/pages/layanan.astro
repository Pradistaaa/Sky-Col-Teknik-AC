---
import MainLayout from "../layouts/MainLayout.astro";
import { services, whatsapp } from "../lib/data.js";
---

<MainLayout
  title="Layanan Service AC | Sky Col Teknik AC"
  description="Layanan service AC, cuci AC, freon, bongkar pasang, dan perbaikan AC di DKI Jakarta."
>

  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="container">

      <span class="section-label">LAYANAN KAMI</span>

      <h1>
        Solusi lengkap
        <span>untuk kebutuhan AC.</span>
      </h1>

      <p>
        Sky Col Teknik AC menyediakan berbagai layanan untuk
        perawatan, pemasangan, dan perbaikan AC di wilayah
        DKI Jakarta.
      </p>

    </div>
  </section>


  <!-- SERVICES -->
  <section class="section">
    <div class="container">

      <div class="service-list">

        {services.map((service, index) => (
          <div class="service-detail">

            <div class="service-number">
              {String(index + 1).padStart(2, "0")}
            </div>

            <div class="service-content">

              <div class="service-icon">
                {index === 0 && "❄"}
                {index === 1 && "◈"}
                {index === 2 && "⌂"}
                {index === 3 && "⚙"}
              </div>

              <h2>{service.title}</h2>

              <p>
                {service.description}
              </p>

              <a
                class="btn btn-primary"
                href={whatsapp(service.title.toLowerCase())}
                target="_blank"
                rel="noopener noreferrer"
              >
                Konsultasi via WhatsApp ↗
              </a>

            </div>

          </div>
        ))}

      </div>

    </div>
  </section>


  <!-- WHY US -->
  <section class="dark-section">
    <div class="container two-column">

      <div>
        <span class="section-label light">
          KENAPA SKY COL?
        </span>

        <h2>
          Satu layanan untuk
          <span>berbagai kebutuhan AC.</span>
        </h2>

        <p class="dark-description">
          Mulai dari perawatan rutin hingga kebutuhan perbaikan,
          Sky Col Teknik AC menyediakan berbagai layanan AC untuk
          rumah, kantor, toko, ruko, dan tempat usaha.
        </p>
      </div>

      <div class="feature-list">

        <div class="feature-item">
          <span>01</span>

          <div>
            <strong>Layanan AC Lengkap</strong>

            <p>
              Berbagai kebutuhan AC tersedia dalam satu layanan.
            </p>
          </div>
        </div>

        <div class="feature-item">
          <span>02</span>

          <div>
            <strong>Harga Transparan</strong>

            <p>
              Daftar harga layanan tersedia untuk membantu
              pelanggan mengetahui estimasi biaya.
            </p>
          </div>
        </div>

        <div class="feature-item">
          <span>03</span>

          <div>
            <strong>Area DKI Jakarta</strong>

            <p>
              Melayani kebutuhan service AC di wilayah
              DKI Jakarta.
            </p>
          </div>
        </div>

        <div class="feature-item">
          <span>04</span>

          <div>
            <strong>Mudah Booking</strong>

            <p>
              Konsultasi dan pemesanan layanan dapat dilakukan
              langsung melalui WhatsApp.
            </p>
          </div>
        </div>

      </div>

    </div>
  </section>


  <!-- CUSTOMER TYPES -->
  <section class="section">
    <div class="container">

      <div class="section-heading">
        <div>
          <span class="section-label">KEBUTUHAN AC</span>

          <h2>
            Untuk rumah maupun
            <span>tempat usaha.</span>
          </h2>
        </div>
      </div>

      <div class="customer-grid">

        <div class="customer-card">
          <span>01</span>
          <h3>Rumah</h3>
          <p>
            Perawatan dan perbaikan AC untuk kebutuhan rumah.
          </p>
        </div>

        <div class="customer-card">
          <span>02</span>
          <h3>Kantor</h3>
          <p>
            Layanan AC untuk mendukung kenyamanan ruang kerja.
          </p>
        </div>

        <div class="customer-card">
          <span>03</span>
          <h3>Toko & Ruko</h3>
          <p>
            Service AC untuk toko, ruko, dan ruang usaha.
          </p>
        </div>

        <div class="customer-card">
          <span>04</span>
          <h3>Tempat Usaha</h3>
          <p>
            Kebutuhan perawatan dan perbaikan AC untuk tempat usaha.
          </p>
        </div>

      </div>

    </div>
  </section>


  <!-- CTA -->
  <section class="cta">
    <div class="container cta-inner">

      <div>
        <span>SKY COL TEKNIK AC</span>

        <h2>
          Butuh layanan AC?<br />
          <strong>Hubungi kami sekarang.</strong>
        </h2>
      </div>

      <a
        class="cta-button"
        href={whatsapp()}
        target="_blank"
        rel="noopener noreferrer"
      >
        <strong>0812 9798 3801</strong>
        <b>↗</b>
      </a>

    </div>
  </section>

</MainLayout>


<style>
  .page-hero {
    padding: 90px 0 80px;
    background:
      radial-gradient(
        circle at 85% 20%,
        rgba(37, 99, 235, 0.12),
        transparent 35%
      ),
      #f8fbff;
  }

  .page-hero h1 {
    max-width: 720px;
    margin: 18px 0 0;
    color: #0f172a;
    font-size: clamp(42px, 6vw, 68px);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .page-hero h1 span {
    display: block;
    color: #2563eb;
  }

  .page-hero p {
    max-width: 650px;
    margin-top: 24px;
    color: #64748b;
    font-size: 17px;
    line-height: 1.8;
  }

  .service-list {
    display: grid;
    gap: 20px;
  }

  .service-detail {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 35px;
    padding: 42px;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    background: #ffffff;
    transition: 0.25s ease;
  }

  .service-detail:hover {
    border-color: #93c5fd;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.07);
    transform: translateY(-3px);
  }

  .service-number {
    color: #2563eb;
    font-size: 18px;
    font-weight: 900;
  }

  .service-content {
    max-width: 700px;
  }

  .service-icon {
    width: 55px;
    height: 55px;
    display: grid;
    place-items: center;
    margin-bottom: 20px;
    border-radius: 16px;
    background: #eff6ff;
    color: #2563eb;
    font-size: 23px;
  }

  .service-content h2 {
    margin: 0;
    color: #0f172a;
    font-size: 30px;
  }

  .service-content p {
    max-width: 620px;
    margin: 14px 0 25px;
    color: #64748b;
    line-height: 1.8;
  }

  .dark-section {
    padding: 90px 0;
    background: #0f172a;
    color: #ffffff;
  }

  .dark-section .section-label {
    color: #60a5fa;
  }

  .dark-section h2 {
    max-width: 600px;
    color: #ffffff;
  }

  .dark-section h2 span {
    display: block;
    color: #60a5fa;
  }

  .dark-description {
    max-width: 540px;
    margin-top: 24px;
    color: #94a3b8;
    line-height: 1.8;
  }

  .feature-list {
    display: grid;
    gap: 10px;
  }

  .feature-item {
    display: grid;
    grid-template-columns: 45px 1fr;
    gap: 18px;
    padding: 22px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .feature-item > span {
    color: #60a5fa;
    font-size: 13px;
    font-weight: 800;
  }

  .feature-item strong {
    font-size: 16px;
  }

  .feature-item p {
    margin: 7px 0 0;
    color: #94a3b8;
    font-size: 14px;
    line-height: 1.6;
  }

  .customer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .customer-card {
    min-height: 190px;
    padding: 26px;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    background: #ffffff;
  }

  .customer-card > span {
    color: #2563eb;
    font-size: 12px;
    font-weight: 900;
  }

  .customer-card h3 {
    margin: 32px 0 10px;
    color: #0f172a;
    font-size: 19px;
  }

  .customer-card p {
    margin: 0;
    color: #64748b;
    font-size: 14px;
    line-height: 1.7;
  }

  .cta {
    padding: 75px 0;
    background: #2563eb;
    color: #ffffff;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .cta-inner > div > span {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    opacity: 0.75;
  }

  .cta h2 {
    margin-top: 12px;
    color: #ffffff;
  }

  .cta h2 strong {
    color: #dbeafe;
  }

  .cta-button {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 18px 22px;
    border-radius: 14px;
    background: #ffffff;
    color: #0f172a;
    white-space: nowrap;
  }

  .cta-button b {
    color: #2563eb;
    font-size: 20px;
  }

  @media (max-width: 900px) {
    .customer-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .two-column {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .page-hero {
      padding: 60px 0;
    }

    .page-hero h1 {
      font-size: 43px;
    }

    .page-hero p {
      font-size: 15px;
    }

    .service-detail {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 28px;
    }

    .service-number {
      font-size: 14px;
    }

    .service-content h2 {
      font-size: 25px;
    }

    .service-content .btn {
      width: 100%;
      text-align: center;
    }

    .customer-grid {
      grid-template-columns: 1fr;
    }

    .cta-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .cta-button {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>